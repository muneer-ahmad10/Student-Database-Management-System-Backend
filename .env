# --- Database ---
# Defaults to local SQLite file if not set. Swap for Postgres/MySQL in production:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/student_db
DATABASE_URL=sqlite:///./student_management.db

# --- App ---
APP_NAME=Student Database Management System
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# --- Gemini / AI Chatbot ---
# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY='AQ.Ab8RN6Jc3TuDBQGICMm6udCZSrP0mEEsLDRyMx8WyFHlySG1pw'
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=student_profiles
